#!/usr/bin/python3
"""Run Natter from wherever this checkout lives.

A Python script rather than a shell wrapper, so the process is called "natter" in task
managers instead of "python3".
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from natter.__main__ import main  # noqa: E402

sys.exit(main())
